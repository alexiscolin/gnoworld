# The demo's settings (docs/OPERATIONS.md): copy to deploy/.env, which git ignores. None is a
# secret: the secrets are files in deploy/secrets/, which compose.yaml names.

# The demo machine's name on the tailnet, so its public address is <name>.<tailnet>.ts.net.
TS_HOSTNAME=gnoworld-demo

# Where the secret files are, when not in deploy/secrets/ (deploy/test.sh points them elsewhere).
# DEMO_HTPASSWD_FILE=./secrets/demo_htpasswd
# TS_AUTHKEY_FILE=./secrets/ts_authkey
