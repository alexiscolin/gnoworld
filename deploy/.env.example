# The demo's settings (docs/OPERATIONS.md): copy to deploy/.env, which git ignores. None is a
# secret: the secrets are files in deploy/secrets/, which compose.yaml names.

# The demo machine's name on the tailnet, so its public address is <name>.<tailnet>.ts.net.
# TS_HOSTNAME=gnoworld-demo

# Where the secret files are, when not in deploy/secrets/ (deploy/test.sh points them elsewhere).
# DEMO_HTPASSWD_FILE=./secrets/demo_htpasswd
# TS_AUTHKEY_FILE=./secrets/ts_authkey

# The app's own origin, which Ergo's WebSocket and the server's POSTs accept (required):
# https://<TS_HOSTNAME>.<tailnet>.ts.net
# ORIGINS=https://gnoworld-demo.example.ts.net
# Ergo's name for itself, a host name nobody resolves.
# SERVER_NAME=irc.gnoworld.example
# The internal network and web's fixed address in it, which Ergo and the server believe (change both if the
# subnet is taken on the host).
# INSIDE_SUBNET=172.30.89.0/24
# WEB_ADDRESS=172.30.89.10
# Ops' own way out for the server's requests (the demo's is the egress service).
# EGRESS_PROXY=http://guard:4750
# The megabytes Ergo's volume may fill before the server's alert at 80% (ergo_volume_near_cap, OPERATIONS.md).
# ERGO_DATA_MB=1024
# ERGO_OPER_PASSWORD_FILE=./secrets/ergo_oper_password
# LOG_PEPPER_FILE=./secrets/log_pepper
# OPENAI_API_KEY_FILE=./secrets/openai_api_key
