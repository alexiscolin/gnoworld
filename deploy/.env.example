# The demo's settings (docs/OPERATIONS.md): copy to deploy/.env, which git ignores. None is a
# secret: the secrets are files in deploy/secrets/, which compose.yaml names.

# The demo machine's name on the tailnet, so its public address is <name>.<tailnet>.ts.net.
# TS_HOSTNAME=gnoworld-demo

# Where the secret files are, when not in deploy/secrets/ (deploy/test.sh points them elsewhere).
# DEMO_HTPASSWD_FILE=./secrets/demo_htpasswd
# TS_AUTHKEY_FILE=./secrets/ts_authkey

# The app's own origin, which Ergo's WebSocket and the server's POSTs accept (required):
# https://<TS_HOSTNAME>.<tailnet>.ts.net
# ORIGINS=https://gnoworld-demo.example.ts.net
# Ergo's name for itself, a host name nobody resolves.
# SERVER_NAME=irc.gnoworld.example
# The internal network and web's fixed address in it, which Ergo and the server believe (change both if the
# subnet is taken on the host).
# INSIDE_SUBNET=172.30.89.0/24
# WEB_ADDRESS=172.30.89.10
# The server's own address there, which its API binds alone (in INSIDE_SUBNET, never web's).
# SERVER_ADDRESS=172.30.89.11
# Ops' own way out for the server's requests (the demo's is the egress service).
# EGRESS_PROXY=http://guard:4750
# The megabytes Ergo's volume may fill before the server's alert at 80% (ergo_volume_near_cap, OPERATIONS.md).
# ERGO_DATA_MB=1024
# ERGO_OPER_PASSWORD_FILE=./secrets/ergo_oper_password
# LOG_PEPPER_FILE=./secrets/log_pepper
# OPENAI_API_KEY_FILE=./secrets/openai_api_key
# ANTHROPIC_API_KEY_FILE=./secrets/anthropic_api_key

# Jarvis (slice 10): off unless on, for jarvis and the server's door both; on, start its profile too, --profile jarvis
# beside --profile demo (10j-4), or the door answers not_ready; ops, without the demo's profile: up -d jarvis.
# JARVIS=on
# jarvis's network, shared with the server alone, and jarvis's address in it (change both together).
# JARVIS_SUBNET=172.30.91.0/24
# JARVIS_ADDRESS=172.30.91.10
# jarvis's way out's network and the guard's address in it (change both together).
# JARVIS_OUT_SUBNET=172.30.95.0/24
# GUARD_JARVIS_ADDRESS=172.30.95.2
# jarvis's reader (gnomcp alone), its network shared with jarvis, and the reader's way out's network with the guard's address
# in it (change each pair together).
# READER_SUBNET=172.30.97.0/24
# READER_ADDRESS=172.30.97.10
# READER_OUT_SUBNET=172.30.99.0/24
# GUARD_READER_ADDRESS=172.30.99.2
# The link cards (slice 13): off unless LINK_CARDS=1, which wants the links profile too (--profile links); the reader's network, shared
# with the server, and its address (change both together), its way out's network and the guard's address in it (change both together).
# LINK_CARDS=1
# LINKS_SUBNET=172.30.101.0/24
# LINK_READER_ADDRESS=172.30.101.10
# LINKS_OUT_SUBNET=172.30.103.0/24
# GUARD_LINKS_ADDRESS=172.30.103.2
# The door's key, which the server and jarvis alone hold (docs/OPERATIONS.md, "Switching Jarvis on").
# JARVIS_DOOR_KEY_FILE=./secrets/jarvis_door_key
# Ops' own way out for jarvis (the demo's is egress_jarvis); gnoscope's tools, off unless on.
# JARVIS_EGRESS_PROXY=http://guard:4751
# JARVIS_GNOSCOPE=on
# A day's budgets, in whole dollars, kept in jarvis's file from its first start (an admin changes them there).
# JARVIS_BUDGET_USD=3
# JARVIS_TRANSLATION_BUDGET_USD=1
# The guest chat (D430): on unless off, which puts the site back to read-only guests; its limits (the server's defaults).
# GUEST_CHAT=off
# GUEST_NAMES_PER_VISITOR_HOUR=10
# GUEST_NAMES_PER_HOUR=600
# GUEST_LIVING=5000
# The admin API's network, the server's address in it (change both together), and the console's sites.
# ADMIN_SUBNET=172.30.92.0/24
# ADMIN_ADDRESS=172.30.92.10
# ADMIN_ORIGINS=https://admin.gnoworld-demo.example.ts.net
