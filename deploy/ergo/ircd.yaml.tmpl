# Ergo's configuration for gnoworld (slice 3b): only the keys gnoworld relies on, each set here rather
# than left to a default. The server's tests render it with folders and ports of their own
# (server/src/testing/ergo.ts), and the stack's image renders the same file (3e). Each name in double
# braces is filled at render, as a JSON value; a key's meaning is in Ergo's default.yaml at the tag (deploy/ergo/VERSION).
network:
  name: gnoworld
server:
  # A hostname, as Ergo asks: the tests' ends in .test (RFC 2606), the stack's is SERVER_NAME (render.sh).
  name: {{NAME}}
  listeners:
    {{PLAIN}}: {}
    {{WEBSOCKET}}:
      websocket: true
  casemapping: ascii
  enforce-utf8: true
  max-sendq: 96k
  proxy-allowed-from: {{PROXY_FROM}}
  websockets:
    allowed-origins: {{ORIGINS}}
  # Ergo's defaults (slice 3's max review): a visitor's address, as web passes it, has 16 connections at once
  # and 32 in 10 minutes, an IPv6 one counted by its /64. The server's link counts under its own address, which
  # the inside network's exemption leaves alone (F720).
  ip-limits:
    count: true
    max-concurrent-connections: 16
    throttle: true
    window: 10m
    max-connections-per-window: 32
    cidr-len-ipv4: 32
    cidr-len-ipv6: 64
    exempted: {{EXEMPT}}
  # A visitor's address shown to nobody: WHOIS, WHO and every line carry a hash of it instead.
  ip-cloaking:
    enabled: true
    enabled-for-always-on: true
    netname: gnoworld
    cidr-len-ipv4: 32
    cidr-len-ipv6: 64
    num-bits: 64
  # A line past the limits is refused (417), never cut short to a meaning its author did not send.
  compatibility:
    allow-truncation: false
accounts:
  authentication-enabled: true
  registration:
    enabled: false
  login-via-pass-command: false
  # Three wrong logins a minute on one connection; ip-limits' throttle bounds the reconnections.
  login-throttling:
    enabled: true
    duration: 1m
    max-attempts: 3
  # Invisible by default: a room's members are listed to its members alone (slice 3's max review).
  default-user-modes: +i
  nick-reservation:
    enabled: true
    method: strict
    force-nick-equals-account: true
  # force-nick-equals-account requires it: one account, several connections (a tab each).
  multiclient:
    enabled: true
    allowed-by-default: true
    always-on: opt-in
    auto-away: opt-in
  auth-script:
    enabled: true
    # One of the two (irc/config.go): the stack's is the server's socket (deploy/compose.yaml), the tests' a
    # command, the sandbox refusing Unix sockets.
    command: {{AUTH_SCRIPT}}
    socket: {{SOCKET}}
    args: []
    autocreate: true
    timeout: {{AUTH_TIMEOUT}}
    kill-timeout: 1s
    max-concurrency: 64
channels:
  # +M: only accounts speak, and +i: none joins, from a room's first line, before the server's reconciler
  # opens the open ones (3m, slice 3's max review).
  default-modes: +ntCMi
  # A visitor's rooms (ADR-0001); the bot, an operator, is in every room of every world past it (client.go).
  max-channels-per-client: 100
  operator-only-creation: true
  registration:
    enabled: true
    operator-only: false
    max-channels-per-account: 15
oper-classes:
  server-admin:
    title: Server Admin
    # The bot's needs alone (slice 3's max review): rooms made (chanreg, with operator-only-creation), joined and
    # set whatever their modes, their history read, unpaced.
    capabilities: [sajoin, samode, chanreg, history, nofakelag]
opers:
  admin:
    class: server-admin
    password: {{OPER_HASH}}
datastore:
  path: {{DATABASE}}
  autoupgrade: true
  sqlite:
    enabled: true
    database-path: {{HISTORY}}
limits:
  nicklen: 32
  identlen: 20
  realnamelen: 150
  channellen: 64
  awaylen: 390
  kicklen: 390
  topiclen: 390
  chan-list-modes: 100
history:
  enabled: true
  channel-length: 2048
  client-length: 256
  chathistory-maxmessages: 1000
  # One time for every room and message (decision 154's 90 days; Ergo v2.19.1 has no time for messages alone).
  restrictions:
    expire-time: 90d
  persistent:
    enabled: true
    unregistered-channels: true
    registered-channels: opt-out
    # Not kept until slice 4 makes them a product: decision 154's 30 days cannot be set apart from rooms'.
    direct-messages: disabled
  retention:
    allow-individual-delete: true
    # An account's messages found by it, for an export or an erasure (ADR-0002).
    enable-account-indexing: true
  tagmsg-storage:
    default: false
    whitelist: ["+draft/react", "+react", "+draft/unreact"]
# On, as in Ergo's defaults, but set by an oper with the metadata capability alone, which none holds (the
# bot's class): nobody sets metadata until a slice needs it.
metadata:
  enabled: true
  operator-only-modification: true
  max-subs: 100
  max-keys: 100
  client-throttle:
    enabled: true
    duration: 2m
    max-attempts: 10
# Ergo's defaults: a client paced past a burst of 5 lines, 2 a second; the bot's class is not (nofakelag).
fakelag:
  enabled: true
  window: 1s
  burst-limit: 5
  messages-per-window: 2
  cooldown: 2s
  command-budgets:
    CHATHISTORY: 16
    MARKREAD: 16
    MONITOR: 1
    WHO: 4
    WEBPUSH: 1
lock-file: {{LOCK}}
# The oper's password hash may come from the environment (ERGO__OPERS__ADMIN__PASSWORD), not the file.
allow-environment-overrides: true
logging:
  - method: stderr
    type: {{LOG_TYPES}}
    level: {{LOG_LEVEL}}
