# What a build in this repository may read (deploy/web/Dockerfile): nothing, but the files listed.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!tsconfig.base.json
!packages/*/package.json
!packages/ui/src
packages/ui/src/**/*.test.ts
packages/ui/src/**/*.test.tsx
packages/ui/src/**/*.stories.tsx
!app
app/node_modules
app/build
app/.react-router
app/test-results
app/test-results-stories
app/playwright-report
app/tests
!app/tests/e2e/workshopData.mjs
app/**/*.test.ts
app/**/*.test.tsx
!deploy/web/nginx.conf
# The server's image (deploy/server/Dockerfile): its workspace and the packages it imports, without their tests.
!server/package.json
!server/roles.json
!server/src
server/src/**/*.test.ts
server/src/testing
!packages/core/src
!packages/schemas/src
packages/core/src/**/*.test.ts
packages/schemas/src/**/*.test.ts
!packages/service/src
packages/service/src/**/*.test.ts
packages/service/src/testing
# And the app's: the chain-read package both import, without its tests and their helpers.
!packages/chain/src
packages/chain/src/**/*.test.ts
packages/chain/src/testing
# Ergo's image and the way out's (deploy/ergo/Dockerfile, deploy/egress/Dockerfile), and their probe.
!deploy/ergo/ircd.yaml.tmpl
!deploy/ergo/render.sh
!deploy/probe
deploy/probe/*_test.go
!deploy/egress/config.yaml
!deploy/egress/acl.yaml
!deploy/egress/jarvis-acl.yaml
# jarvis's image (deploy/jarvis/Dockerfile): its workspace, its skills and gnomcp's settings, without its tests, its
# benches and its test helpers (testing/outbound.ts would move Anthropic's traffic); the places' data comes with !app.
!jarvis/package.json
!jarvis/src
jarvis/src/**/*.test.ts
jarvis/src/**/*.bench.ts
jarvis/src/testing
!jarvis/skills
!deploy/jarvis/gnomcp.toml
# Named as well, should the list above ever open: the demo's secrets never reach a build.
deploy/secrets
# Claude Code's own folder, which a session leaves wherever it starts (packages/core/src, server/src, app): its .cc-writes is
# private to its owner, so an image's user cannot list the folder that holds it (test-jarvis.sh's "jarvis's entry" read nothing).
**/.claude
