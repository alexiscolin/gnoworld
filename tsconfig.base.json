{
  "compilerOptions": {
    "target": "es2024",
    // No DOM, which es2024 would bring by default; and TypeScript 6 loads no @types unless asked,
    // so core reaches no network, window or process. A workspace that needs them adds its own.
    "lib": ["es2024"],
    "module": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true
  }
}
