{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./deploy/secrets/**)",
      "Read(./**/dist/**)",
      "Read(./**/coverage/**)",
      "Read(./reports/**)"
    ],
    "ask": ["Bash(git push)", "Bash(git push *)", "Bash(pnpm add *)", "Bash(rm -rf *)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/stop_gate.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/scripts/guard_git.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/format_hook.sh\""
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true
  },
  "sandbox": {
    "enabled": true,
    "network": {
      "allowedDomains": [
        "registry.npmjs.org",
        "proxy.golang.org",
        "sum.golang.org",
        "github.com",
        "api.github.com",
        "codeload.github.com",
        "objects.githubusercontent.com",
        "rpc.gno.land",
        "rpc.onyx.testnets.gno.land",
        "semgrep.dev"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/gno-toolchains",
        "~/.cache/gnoworld-tools",
        "~/Library/Caches/go-build",
        "~/go/pkg/mod",
        "~/Library/pnpm",
        "~/Library/Caches/ms-playwright"
      ]
    }
  }
}
