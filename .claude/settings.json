{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/deploy/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)",
      "Read(~/.aws/**)",
      "Bash(pnpm add *)",
      "Bash(rm -rf *)",
      "Edit(/scripts/guard.py)",
      "Edit(/server/package.json)",
      "Edit(/jarvis/package.json)",
      "Edit(/evals/package.json)",
      "Edit(/packages/schemas/package.json)",
      "Edit(/scripts/stop_gate.sh)",
      "Edit(/scripts/code_changed.sh)",
      "Edit(/scripts/scan_secrets.sh)",
      "Edit(/scripts/gitleaks.toml)",
      "Edit(/scripts/gitleaks-private.toml)",
      "Edit(/scripts/.gitleaksignore)",
      "Edit(/scripts/install_hooks.sh)",
      "Edit(/scripts/worktree.sh)",
      "Edit(/scripts/borrow_node_modules.sh)",
      "Edit(~/Server/gnoworld-wt/*/.git)",
      "Edit(~/Server/gnoworld/.git/hooks/**)",
      "Edit(~/Server/gnoworld/.git/config)",
      "Edit(~/Server/gnoworld/scripts/**)",
      "Edit(~/Server/gnoworld/.githooks/**)",
      "Edit(/.git/hooks/**)",
      "Edit(/.git/config)",
      "Edit(/.git/commondir)",
      "Edit(/.mcp.json)",
      "Edit(/.githooks/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/commands/**)",
      "Edit(/.claude/workflows/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/.claude/rules/**)",
      "Edit(/.claude/hooks/**)",
      "Edit(/package.json)",
      "Edit(/app/package.json)",
      "Edit(/packages/*/package.json)",
      "Edit(/.npmrc)",
      "Edit(/pnpm-workspace.yaml)",
      "Edit(/.pnpmfile.cjs)",
      "Edit(/.pnpmfile.mjs)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "mcp__gnomcp__gno_addpkg",
      "mcp__gnomcp__gno_call",
      "mcp__gnomcp__gno_run",
      "mcp__gnomcp__gno_key_send",
      "mcp__gnomcp__gno_cla_sign",
      "mcp__plugin_gnomcp_gnomcp__gno_addpkg",
      "mcp__plugin_gnomcp_gnomcp__gno_call",
      "mcp__plugin_gnomcp_gnomcp__gno_run",
      "mcp__plugin_gnomcp_gnomcp__gno_key_send",
      "mcp__plugin_gnomcp_gnomcp__gno_cla_sign"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/stop_gate.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|WebFetch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/scripts/guard.py\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "gnoverse": { "source": { "source": "github", "repo": "gnoverse/gno-mcp" } }
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "gnomcp@gnoverse": true
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["sh scripts/worktree.sh *"],
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": ["registry.npmjs.org", "proxy.golang.org", "sum.golang.org", "github.com"]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/gno-toolchains/onyx/gnohome",
        "~/.cache/gnoworld-tools",
        "~/.cache/go-build",
        "~/Library/Caches/go-build",
        "~/go/pkg/mod"
      ],
      "denyWrite": [
        "scripts",
        ".githooks",
        ".github",
        "package.json",
        "pnpm-lock.yaml",
        ".node-version",
        ".gitignore",
        "CLAUDE.md",
        ".claude/CLAUDE.md",
        ".claude/rules",
        ".npmrc",
        "pnpm-workspace.yaml",
        ".pnpmfile.cjs",
        ".pnpmfile.mjs",
        "eslint.config.ts",
        "vitest.config.ts",
        "stryker.config.json",
        "knip.json",
        ".jscpd.json",
        "tsconfig.base.json",
        "tsconfig.json",
        "app/tsconfig.json",
        "server/tsconfig.json",
        "jarvis/tsconfig.json",
        "packages/*/tsconfig.json",
        "*.config.ts",
        "app/*.config.ts",
        "lint/*.config.ts",
        ".nvmrc",
        "app/tests/stories/pictures.spec.ts",
        "deploy/test.sh",
        ".prettierrc.json",
        ".prettierignore",
        ".git/hooks",
        ".git/config",
        ".git/commondir",
        "~/Server/gnoworld-wt/*/.git",
        ".mcp.json"
      ],
      "denyRead": ["~/.ssh", "~/.config/gh", "~/.npmrc", "~/.aws"]
    }
  }
}
