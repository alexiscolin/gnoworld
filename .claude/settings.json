{
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "blockWritesOutsideWorkingDirectories": true,
    "deny": [
      "Read(/.env)",
      "Read(/.env.local)",
      "Read(/deploy/secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/**)",
      "Read(~/.npmrc)",
      "Read(~/.aws/**)",
      "Read(~/.local/share/gnomcp/**)",
      "Read(~/.local/share/agent-github/**)",
      "Edit(~/.local/share/agent-github/**)",
      "Edit(~/.local/**)",
      "Edit(~/.claude/hooks/**)",
      "Read(~/Library/Application Support/gno/**)",
      "Read(~/.claude.json)",
      "Bash(pnpm add *)",
      "Bash(rm -rf *)",
      "Edit(/scripts/guard.py)",
      "Edit(/server/package.json)",
      "Edit(/jarvis/package.json)",
      "Edit(/evals/package.json)",
      "Edit(/link-reader/package.json)",
      "Edit(/evals/pnpm-workspace.yaml)",
      "Edit(/evals/.pnpmfile.cjs)",
      "Edit(/evals/.pnpmfile.mjs)",
      "Edit(/packages/schemas/package.json)",
      "Edit(/scripts/stop_gate.sh)",
      "Edit(/scripts/scan_secrets.sh)",
      "Edit(/scripts/gitleaks.toml)",
      "Edit(/scripts/gitleaks-private.toml)",
      "Edit(/scripts/.gitleaksignore)",
      "Edit(/scripts/install_hooks.sh)",
      "Edit(/scripts/worktree.sh)",
      "Edit(/scripts/borrow_node_modules.sh)",
      "Edit(/scripts/check.sh)",
      "Edit(/scripts/check_docs.py)",
      "Edit(/scripts/ergo.sh)",
      "Edit(/scripts/hidden.py)",
      "Edit(/scripts/related.py)",
      "Edit(/scripts/speeds.py)",
      "Edit(/scripts/workshop.sb)",
      "Edit(/scripts/workshop.sh)",
      "Edit(/tools/agent-github/**)",
      "Edit(/.git/hooks/**)",
      "Edit(/.git/config)",
      "Edit(/.git/commondir)",
      "Edit(/.mcp.json)",
      "Edit(/.githooks/**)",
      "Edit(/.claude/settings.json)",
      "Edit(/.claude/settings.local.json)",
      "Edit(/CLAUDE.md)",
      "Edit(/CLAUDE.local.md)",
      "Edit(/.claude/CLAUDE.md)",
      "Edit(/**/CLAUDE.md)",
      "Edit(/**/CLAUDE.local.md)",
      "Edit(/**/AGENTS.md)",
      "Edit(/**/.claude/rules/**)",
      "Edit(/**/.claude/skills/**)",
      "Edit(/.claude/agents/**)",
      "Edit(/.claude/commands/**)",
      "Edit(/.claude/workflows/**)",
      "Edit(/.claude/skills/**)",
      "Edit(/.claude/rules/**)",
      "Edit(/.claude/hooks/**)",
      "Edit(/package.json)",
      "Edit(/app/package.json)",
      "Edit(/packages/*/package.json)",
      "Edit(/.npmrc)",
      "Edit(/pnpm-workspace.yaml)",
      "Edit(/.pnpmfile.cjs)",
      "Edit(/.pnpmfile.mjs)",
      "Edit(//private/tmp/CLAUDE.md)",
      "Edit(//private/tmp/CLAUDE.local.md)",
      "Edit(//private/tmp/.claude/CLAUDE.md)",
      "Edit(//private/tmp/.claude/rules/**)",
      "Edit(//private/tmp/AGENTS.md)",
      "Edit(//private/tmp/.claude/AGENTS.md)",
      "Edit(//tmp/CLAUDE.md)",
      "Edit(//tmp/CLAUDE.local.md)",
      "Edit(//tmp/.claude/CLAUDE.md)",
      "Edit(//tmp/.claude/rules/**)",
      "Edit(//tmp/AGENTS.md)",
      "Edit(//tmp/.claude/AGENTS.md)",
      "Edit(~/CLAUDE.md)",
      "Edit(~/CLAUDE.local.md)",
      "Edit(~/.claude/CLAUDE.md)",
      "Edit(~/.claude/rules/**)",
      "Edit(~/AGENTS.md)",
      "Edit(~/.claude/AGENTS.md)"
    ],
    "ask": [
      "Bash(git push)",
      "Bash(git push *)",
      "mcp__gnomcp__gno_addpkg",
      "mcp__gnomcp__gno_call",
      "mcp__gnomcp__gno_run",
      "mcp__gnomcp__gno_key_send",
      "mcp__gnomcp__gno_cla_sign",
      "mcp__plugin_gnomcp_gnomcp__gno_addpkg",
      "mcp__plugin_gnomcp_gnomcp__gno_call",
      "mcp__plugin_gnomcp_gnomcp__gno_run",
      "mcp__plugin_gnomcp_gnomcp__gno_key_send",
      "mcp__plugin_gnomcp_gnomcp__gno_cla_sign"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/scripts/stop_gate.sh\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|WebFetch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$CLAUDE_PROJECT_DIR/scripts/guard.py\"",
            "onFailure": "block"
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I \"$HOME/.claude/hooks/agent_pr_guard.py\" \"$HOME/.local/bin/agent-pr\"",
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "gnoverse": {
      "source": {
        "source": "github",
        "repo": "gnoverse/gno-mcp"
      }
    }
  },
  "enabledPlugins": {
    "typescript-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "gnomcp@gnoverse": true
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": ["sh scripts/worktree.sh *", "~/.local/bin/agent-pr *"],
    "network": {
      "allowLocalBinding": true,
      "allowedDomains": ["registry.npmjs.org", "proxy.golang.org", "sum.golang.org", "github.com"]
    },
    "filesystem": {
      "allowWrite": [
        "~/.cache/gno-toolchains/onyx/gnohome",
        "~/.cache/gnoworld-tools",
        "~/.cache/go-build",
        "~/Library/Caches/go-build",
        "~/go/pkg/mod"
      ],
      "denyWrite": [
        "scripts",
        "tools/agent-github",
        ".githooks",
        ".github",
        "package.json",
        "pnpm-lock.yaml",
        ".node-version",
        ".gitignore",
        "CLAUDE.md",
        "CLAUDE.local.md",
        ".claude/CLAUDE.md",
        ".claude/rules",
        "**/CLAUDE.md",
        "**/CLAUDE.local.md",
        "**/AGENTS.md",
        "**/.claude/rules",
        "**/.claude/skills",
        ".npmrc",
        "pnpm-workspace.yaml",
        ".pnpmfile.cjs",
        ".pnpmfile.mjs",
        "eslint.config.ts",
        "vitest.config.ts",
        "stryker.config.json",
        "knip.json",
        ".jscpd.json",
        "tsconfig.base.json",
        "tsconfig.json",
        "app/tsconfig.json",
        "server/tsconfig.json",
        "jarvis/tsconfig.json",
        "link-reader/tsconfig.json",
        "stryker.all.config.json",
        ".gitattributes",
        "evals/pnpm-lock.yaml",
        "evals/tsconfig.json",
        "packages/*/tsconfig.json",
        "*.config.ts",
        "app/*.config.ts",
        "lint/*.config.ts",
        ".nvmrc",
        "app/tests/stories/pictures.spec.ts",
        "deploy/test.sh",
        ".prettierrc.json",
        ".prettierignore",
        ".git/hooks",
        ".git/config",
        ".git/commondir",
        ".mcp.json"
      ],
      "denyRead": [
        "~/.ssh",
        "~/.config/gh",
        "~/.npmrc",
        "~/.aws",
        "~/.local/share/gnomcp",
        "~/Library/Application Support/gno",
        "~/.claude.json",
        "~/.local/share/agent-github"
      ]
    }
  }
}
