#!/bin/sh
set -eu
# The gate runs before every commit that changes code (ADR-0001 §14), on what is
# staged rather than on the working tree. Only prose is exempt (scripts/code_changed.sh),
# so a new code folder or a settings change is gated; scripts/test_hooks.sh checks the hooks.
# Every script it runs comes from the staged copy, the one the commit holds (finding F067).
. "$(dirname "$0")/records.sh"
if [ -z "${SANDBOX_RUNTIME:-}" ]; then
	# Outside Claude Code's sandbox, in Alexis's shell, no gate runs, so no code Claude can edit
	# runs with his access (F076): only the scripts installed beside the hooks, where no branch
	# writes (F129), and the staged code must be code the sandboxed gate passed. Prose alone
	# needs no gate.
	# A merge writes the branch's files before any hook runs: one that changes the harness came
	# through merge.sh, which showed them to Alexis first and names the commit it merges; the
	# merge of that commit must be what is committed (F129). pre-merge-commit says --merge, since
	# git writes MERGE_HEAD only after it; a merge concluded by hand has one, a squash its message.
	if [ "${1:-}" = --merge ] || git rev-parse -q --verify MERGE_HEAD >/dev/null || [ -e "$(git rev-parse --git-path SQUASH_MSG)" ]; then
		if foreign --cached HEAD; then
			echo "pre-commit: this merge holds a path with a non-ASCII character, which this disk may read as another path; undo it now (git merge --abort, or git reset --hard after a squash) (F164)" >&2
			exit 1
		fi
		changed=$(harness --cached --name-only HEAD)
		if [ -n "$changed" ]; then
			# Each harness file is committed as the merge of the commit merge.sh showed holds it (records.sh's merge_of), none
			# in conflict; the other files, every merge's ledgers first, are resolved by hand, and the gate below checks their
			# code (9n). Nor is a merge read through .git/info, which any session can write (9n's /pre-merge).
			merged=$(merge_of "${GNOWORLD_MERGE:-}")
			tree=$(printf '%s\n' "$merged" | sed -n 1p)
			clash=$(printf '%s\n' "$merged" | sed 1d)
			rewiring=$(rewired)
			why=
			if [ -n "$rewiring" ]; then
				why="$rewiring, which any session can write, changes how git merged it"
			elif [ -z "$tree" ]; then
				why="names no commit merge.sh showed (GNOWORLD_MERGE)"
			elif [ -n "$clash" ]; then
				why="a harness file was in conflict, so it is not as merge.sh showed it: $clash"
			else
				drift=$(harness --cached --name-only "$tree")
				[ -z "$drift" ] || why="its harness differs from the merge merge.sh showed: $drift"
			fi
			if [ -n "$why" ]; then
				echo "pre-commit: this merge changes the harness, but $why; undo it now (git merge --abort, or git reset --hard after a squash), then sh .git/hooks/merge.sh <branch>" >&2
				exit 1
			fi
		fi
	fi
	sh "$(dirname "$0")/scan_secrets.sh" --staged
	prose=0 # code_changed.sh exits 1 for prose alone; any other failure refuses the commit
	sh "$(dirname "$0")/code_changed.sh" --staged || prose=$?
	[ "$prose" -le 1 ] || { echo "pre-commit: code_changed.sh failed (exit $prose); nothing is committed unchecked" >&2; exit 1; }
	if [ "$prose" = 0 ] && ! green "$(git write-tree)" fast; then
		echo "pre-commit: no gate passed on exactly this code; let sh scripts/check.sh pass on it in Claude Code's sandbox, then stage all of it, or let Claude commit it there" >&2
		exit 1
	fi
	exit 0
fi
staged=$(mktemp -d "${TMPDIR:-/tmp}/pre-commit.XXXXXX") # in $TMPDIR, which the sandbox allows
# bash 3.2, macOS's sh, exits 0 through an EXIT trap after an unbound variable: `finished`, set
# on the last line, tells a run that reached its end from one that died on the way.
trap 'status=$?; rm -rf "$staged" || :; [ "$status" != 0 ] || [ "${finished:-}" = 1 ] || status=1; exit "$status"' EXIT
trap 'exit 1' HUP INT TERM # so the EXIT trap also runs on Ctrl-C under dash
git checkout-index -a --ignore-skip-worktree-bits --prefix="$staged/"
s="$staged/scripts"
sh "$s/scan_secrets.sh" --staged # no secret enters a commit, prose included
prose=0 # as outside: exit 1 is prose alone, any other failure refuses the commit
sh "$s/code_changed.sh" --staged || prose=$?
[ "$prose" -le 1 ] || { echo "pre-commit: code_changed.sh failed (exit $prose); nothing is committed unchecked" >&2; exit 1; }
if [ "$prose" = 1 ]; then
	python3 -I "$s/check_docs.py" # docs only: the files they name must still exist
	finished=1
	exit 0
fi
# The staged gate is the one that runs; -z keeps a name with a space or an accent whole.
differ=$(git diff --cached --name-only -z -- scripts .githooks .github .claude/settings.json | xargs -0 -r git -c core.quotePath=false diff --name-only --)
if [ -n "$differ" ]; then
	echo "pre-commit: staged harness files differ from the working tree's; stage them as they are on disk: $differ" >&2
	exit 1
fi
sh "$s/borrow_node_modules.sh" "$staged" # the staged copy has no installed packages
# What the commit changes, one path a line, so check.sh checks those areas alone: the copy has no
# repository to ask. A list git cannot give is empty, and check.sh then checks everything.
changed=$(git -c core.quotePath=false diff --cached --no-renames --name-only HEAD 2>/dev/null) || changed=
# A `commit -a` hands the hook its own index; the gate's git calls must not touch it.
# A merge commit has no time budget, and the copy has no repository to say it is one: pre-merge-commit's --merge (git writes
# MERGE_HEAD only after that hook), or a merge in progress. Always set, so a caller's own value counts for nothing.
merge=0
{ [ "${1:-}" = --merge ] || git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; } && merge=1
# A commit that touches a test, a bench or an approved picture runs the staged check_regressions.py here, in the repository (the
# copy has no git), with the base check.sh takes: where the branch left main, so a `Removed-test:` line of an earlier commit of the
# branch counts, else HEAD (a renamed test passed the fast gate in 5b and failed only the merge check). Not in a merge, whose full
# gate follows, nor with no commit yet. The list of tests is check.sh's, the same.
tests=$(printf '%s\n' "$changed" | grep -E '\.(test|bench)\.tsx?$|\.spec\.ts$|_test\.(gno|go)$|-snapshots/.*\.png$|__screenshots__/.*\.png$' || :)
if [ "$merge" = 0 ] && [ -n "$tests" ] && base=$(git merge-base HEAD origin/main 2>/dev/null || git rev-parse -q --verify HEAD 2>/dev/null); then
	nodebin= # Vitest's list in check_regressions reads the Node .node-version pins (a bare shell may hold another)
	[ ! -f .node-version ] || nodebin="${NVM_DIR:-$HOME/.nvm}/versions/node/v$(cat .node-version)/bin:"
	env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE PATH="$nodebin$PATH" python3 -I "$s/check_regressions.py" --quick "$base"
fi
env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE GATE_CHANGED="$changed" GATE_MERGE=$merge sh "$s/check.sh"
put "$(code_print "$(git write-tree)")" fast # for the hooks outside the sandbox
finished=1
