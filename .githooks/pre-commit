#!/bin/sh
set -eu
# pre-commit (D13173): no secret enters a commit, prose included; from Claude Code's sandbox no harness file either (D241); and there
# the staged files are formatted and the docs name only files that exist. The rest of the checks are scripts/check.sh's, which a
# session runs before committing code, and GitHub's, which judge each pull request. In Alexis's shell nothing of the working tree
# runs (F076): only the scan installed beside this hook, from main.
# Git hands a hook GIT_DIR and GIT_INDEX_FILE, never these: a caller's object folder, or a copy of its common folder, would answer
# the reads below with a HEAD of its choice, one that hides a staged harness file (7w2, F4923).
unset GIT_COMMON_DIR GIT_OBJECT_DIRECTORY
. "$(dirname "$0")/records.sh"
# The sandbox stops a shell's writes, not the file tools' (an agent's Edit of stryker.config.json passed its commit, f792bf47). A
# sandboxed command can unset SANDBOX_RUNTIME, never the sandbox's ban on writing the installed hooks: a hook that cannot open itself
# for writing runs in the sandbox too. In a subshell: under dash, Linux's sh, a redirection `:` cannot open ends the whole shell (F13177).
sandboxed=false
if [ -n "${SANDBOX_RUNTIME:-}" ] || ! (: >>"$0") 2>/dev/null; then sandboxed=true; fi
# A letter the disk folds names a file no list can match (ſ is s on APFS: packageſ/ lands as packages/, a workspace pnpm installs): a
# path with one is refused, from the sandbox and in Alexis's shell, a merge's too (F164); GitHub's changes job refuses it on its side.
if foreign --cached; then
	echo "pre-commit: a path with a non-ASCII character, which this disk may read as another, a harness file's among them (F164)" >&2
	exit 1
fi
if $sandboxed; then
	held=$(harness --cached --name-only) || { echo "pre-commit: git could not list the staged harness files; nothing is committed unchecked" >&2; exit 1; }
	if [ -n "$held" ]; then
		echo "pre-commit: a harness file is committed in Alexis's Terminal alone, never from Claude Code's sandbox (D241): $held" >&2
		exit 1
	fi
fi
sh "$(dirname "$0")/scan_secrets.sh" --staged
$sandboxed || exit 0
# The staged files that exist, NUL-separated in a file of $TMPDIR: a name with a space, an accent or a newline stays whole, and a
# git that fails stops the commit instead of handing on an empty list.
work=$(mktemp -d "${TMPDIR:-/tmp}/pre-commit.XXXXXX")
# bash 3.2, macOS's sh, exits 0 through an EXIT trap after an unbound variable: `finished`, set on the last line, tells a run that
# reached its end from one that died on the way.
trap 'status=$?; rm -rf "${work:?}" || :; [ "$status" != 0 ] || [ "${finished:-}" = 1 ] || status=1; exit "$status"' EXIT
trap 'exit 1' HUP INT TERM # so the EXIT trap also runs on Ctrl-C under dash
list=$work/list files=$work/files
git diff --cached --name-only -z --diff-filter=d >"$list"
# Prettier and check_docs read the disk: a staged file changed since it was staged is refused, never checked in a form the commit
# does not hold. Each name a name, never a pathspec: `:(exclude)a.ts` staged beside a.ts took it out of the comparison.
differ=$(xargs -0 -r git -c core.quotePath=false --literal-pathspecs diff --name-only -- <"$list")
[ -z "$differ" ] || { echo "pre-commit: staged files differ from the working tree's; stage them as they are on disk: $differ" >&2; exit 1; }
# Prettier as package.json's format:check runs it, the one place its command is written (check.sh reads it too), its last word, the
# whole repository, replaced by the staged regular files: Prettier refuses a link named on its line, and a submodule is no file.
format=$(node -p "require('./package.json').scripts['format:check']") || { echo "pre-commit: node cannot read package.json's format:check" >&2; exit 1; }
case $format in *" .") ;; *)
	echo "pre-commit: package.json's format:check does not end with ' .', so the staged files cannot be named in its place: $format" >&2
	exit 1
	;;
esac
python3 -I -c '
import subprocess, sys
raw = subprocess.run(["git", "diff", "--cached", "--raw", "-z", "--no-renames", "--diff-filter=d"], capture_output=True, check=True).stdout.split(b"\0")
sys.stdout.buffer.write(b"".join(raw[i + 1] + b"\0" for i in range(0, len(raw) - 1, 2) if raw[i].split(b" ")[1] in (b"100644", b"100755")))
' >"$files"
PATH="$PWD/node_modules/.bin:$PATH" xargs -0 -r sh -c "${format% .} --ignore-unknown -- \"\$@\"" sh <"$files"
python3 -I scripts/check_docs.py
finished=1
