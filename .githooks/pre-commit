#!/bin/sh
set -eu
# The gate runs before every commit that changes code (ADR-0001 §14), on what is
# staged rather than on the working tree. Only prose is exempt (scripts/code_changed.sh),
# so a new code folder or a settings change is gated; scripts/test_hooks.sh checks the hooks.
# Every script it runs comes from the staged copy, the one the commit holds (finding F067).
. "$(dirname "$0")/records.sh"
if [ -z "${SANDBOX_RUNTIME:-}" ]; then
	# Outside Claude Code's sandbox, in Alexis's shell, no gate runs, so no code Claude can edit
	# runs with his access (F076): only the scripts installed beside the hooks, where no branch
	# writes (F129), and the staged code must be code the sandboxed gate passed. Prose alone
	# needs no gate.
	# A merge writes the branch's files before any hook runs: one that changes the harness came
	# through merge.sh, which showed them to Alexis first and names the commit it merges; the
	# merge of that commit must be what is committed (F129). pre-merge-commit says --merge, since
	# git writes MERGE_HEAD only after it; a merge concluded by hand has one.
	if [ "${1:-}" = --merge ] || git rev-parse -q --verify MERGE_HEAD >/dev/null; then
		changed=$(harness --cached --name-only HEAD)
		if [ -n "$changed" ] && [ "$(git merge-tree --write-tree HEAD "${GNOWORLD_MERGE:-}" 2>/dev/null)" != "$(git write-tree)" ]; then
			echo "pre-commit: this merge changes the harness, which merge.sh did not show you first, and has written it: run git merge --abort now, then sh .git/hooks/merge.sh <branch>" >&2
			exit 1
		fi
	fi
	sh "$(dirname "$0")/scan_secrets.sh" --staged
	prose=0 # code_changed.sh exits 1 for prose alone; any other failure refuses the commit
	sh "$(dirname "$0")/code_changed.sh" --staged || prose=$?
	[ "$prose" -le 1 ] || { echo "pre-commit: code_changed.sh failed (exit $prose); nothing is committed unchecked" >&2; exit 1; }
	if [ "$prose" = 0 ] && ! green "$(git write-tree)" fast; then
		echo "pre-commit: no gate passed on exactly this code; let sh scripts/check.sh pass on it in Claude Code's sandbox, then stage all of it, or let Claude commit it there" >&2
		exit 1
	fi
	exit 0
fi
staged=$(mktemp -d "${TMPDIR:-/tmp}/pre-commit.XXXXXX") # in $TMPDIR, which the sandbox allows
# bash 3.2, macOS's sh, exits 0 through an EXIT trap after an unbound variable: `finished`, set
# on the last line, tells a run that reached its end from one that died on the way.
trap 'status=$?; rm -rf "$staged" || :; [ "$status" != 0 ] || [ "${finished:-}" = 1 ] || status=1; exit "$status"' EXIT
trap 'exit 1' HUP INT TERM # so the EXIT trap also runs on Ctrl-C under dash
git checkout-index -a --ignore-skip-worktree-bits --prefix="$staged/"
s="$staged/scripts"
sh "$s/scan_secrets.sh" --staged # no secret enters a commit, prose included
prose=0 # as outside: exit 1 is prose alone, any other failure refuses the commit
sh "$s/code_changed.sh" --staged || prose=$?
[ "$prose" -le 1 ] || { echo "pre-commit: code_changed.sh failed (exit $prose); nothing is committed unchecked" >&2; exit 1; }
if [ "$prose" = 1 ]; then
	python3 -I "$s/check_docs.py" # docs only: the files they name must still exist
	finished=1
	exit 0
fi
# The staged gate is the one that runs; -z keeps a name with a space or an accent whole.
differ=$(git diff --cached --name-only -z -- scripts .githooks .github .claude/settings.json | xargs -0 -r git -c core.quotePath=false diff --name-only --)
if [ -n "$differ" ]; then
	echo "pre-commit: staged harness files differ from the working tree's; stage them as they are on disk: $differ" >&2
	exit 1
fi
sh "$s/borrow_node_modules.sh" "$staged" # the staged copy has no installed packages
# A `commit -a` hands the hook its own index; the gate's git calls must not touch it.
env -u GIT_INDEX_FILE -u GIT_DIR -u GIT_WORK_TREE sh "$s/check.sh"
put "$(code_print "$(git write-tree)")" fast # for the hooks outside the sandbox
finished=1
