#!/bin/sh
# pre-push: main needs the full gate and a committed review pass (docs/REVIEW.md), a work branch
# the fast gate, every push the secret scan, since nothing leaves with a secret. Outside Claude
# Code's sandbox no gate runs, only the records the sandboxed gate wrote (F076). Git sends one
# line per ref: <local ref> <local sha> <remote ref> <remote sha>.
set -eu
. "$(dirname "$0")/records.sh"
zero=0000000000000000000000000000000000000000
outside=false
[ -n "${SANDBOX_RUNTIME:-}" ] || outside=true
gated=false
refuse() {
	echo "pre-push: $1" >&2
	exit 1
}
# A branch's gate is its own harness, so a harness file it changes (records.sh's list) is declared
# on a line of a commit, `Harness-changed: <path> - why`, which Alexis reads in review (F089).
declared() { # $1: the path; stdin: the commit messages
	while IFS= read -r line; do
		case $line in "Harness-changed: $1 - "?*) return 0 ;; esac
	done
	return 1
}
while read -r _ local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # a deleted branch
	if [ "$local_sha" != "$(git rev-parse HEAD)" ] || [ -n "$(git status --porcelain)" ]; then
		refuse "push the commit you have checked out, with nothing uncommitted or untracked, so the gate checks what leaves"
	fi
	if [ "$remote_ref" = refs/heads/main ]; then
		if [ "$remote_sha" != "$zero" ]; then
			# A main this clone has not fetched cannot be compared: refused, not passed (F116).
			changed=$(harness --name-only "$remote_sha" "$local_sha") || refuse "fetch main first: $remote_sha is not in this clone"
			undeclared=$(printf '%s\n' "$changed" | while IFS= read -r f; do
				git log --format=%B "$remote_sha..$local_sha" | declared "$f" || printf '%s\n' "$f"
			done)
			[ -z "$undeclared" ] || refuse "harness files changed with no \`Harness-changed: <path> - why\` line in a commit:
$undeclared"
		fi
		if $outside; then
			# What runs in Alexis's shell is what was reviewed: the hooks of the main that leaves (F129).
			sh "$(dirname "$0")/install_hooks.sh" --check "$local_sha" || refuse "install the hooks of this main first: git --no-replace-objects show main:scripts/install_hooks.sh | sh"
			green "$local_sha" full || refuse "the full gate never passed on this code; run /pre-merge in Claude Code"
			reviewed "$local_sha" || refuse "no committed review pass for this code; run /pre-merge and commit its record"
			gated=true
		else
			python3 -I scripts/review_pass.py check "$local_sha" # cheap, so before the gate
			sh scripts/check.sh --full </dev/null
		fi
	elif $outside; then
		green "$local_sha" fast || refuse "no gate passed on this code; run sh scripts/check.sh in Claude Code's sandbox"
		gated=true
	elif ! $gated; then
		sh scripts/check.sh </dev/null
		gated=true
	fi
done
# One scan of the whole history covers every ref this push sends; the full gate scans it too.
! $gated || sh "$(dirname "$0")/scan_secrets.sh"
