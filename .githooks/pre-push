#!/bin/sh
# pre-push: main gets the full gate and needs a committed review pass (docs/REVIEW.md); a work
# branch gets the fast gate and the secret scan, since nothing leaves with a secret. Git sends one
# line per ref: <local ref> <local sha> <remote ref> <remote sha>.
set -eu
. "$(dirname "$0")/records.sh"
zero=0000000000000000000000000000000000000000
gated=false
# A branch's gate is its own harness, so a harness file it changes is declared on a line of a
# commit, `Harness-changed: <path> - why`, which Alexis reads in review (F089). This hook asks
# before any edit, so a branch cannot drop the check.
harness() {
	git -c core.quotePath=false diff --name-only "$1" "$2" -- scripts .githooks .github .claude package.json app/package.json \
		pnpm-workspace.yaml pnpm-lock.yaml .node-version .nvmrc .npmrc '*.config.ts' tsconfig.json tsconfig.base.json app/tsconfig.json \
		stryker.config.json knip.json .jscpd.json .prettierrc.json .prettierignore .gitignore
}
declared() { # $1: the path; stdin: the commit messages
	while IFS= read -r line; do
		case $line in "Harness-changed: $1 - "?*) return 0 ;; esac
	done
	return 1
}
while read -r _ local_sha remote_ref remote_sha; do
	[ "$local_sha" = "$zero" ] && continue # a deleted branch
	if [ "$local_sha" != "$(git rev-parse HEAD)" ] || [ -n "$(git status --porcelain)" ]; then
		echo "pre-push: push the commit you have checked out, with nothing uncommitted or untracked, so the gate checks what leaves" >&2
		exit 1
	fi
	if [ "$remote_ref" = refs/heads/main ]; then
		if [ "$remote_sha" != "$zero" ]; then
			# A main this clone has not fetched cannot be compared: refused, not passed (F116).
			changed=$(harness "$remote_sha" "$local_sha") || { echo "pre-push: fetch main first: $remote_sha is not in this clone" >&2; exit 1; }
			undeclared=$(printf '%s\n' "$changed" | while IFS= read -r f; do
				git log --format=%B "$remote_sha..$local_sha" | declared "$f" || printf '%s\n' "$f"
			done)
			if [ -n "$undeclared" ]; then
				printf 'pre-push: harness files changed with no `Harness-changed: <path> - why` line in a commit:\n%s\n' "$undeclared" >&2
				exit 1
			fi
		fi
		if [ -z "${SANDBOX_RUNTIME:-}" ]; then
			# Outside the sandbox no gate runs (F076): the full gate and a review recorded this code.
			green "$local_sha" .claude/tmp/green-full || { echo "pre-push: the full gate never passed on this code; run /pre-merge in Claude Code" >&2; exit 1; }
			reviewed "$local_sha" || { echo "pre-push: no committed review pass for this code; run /pre-merge and commit its record" >&2; exit 1; }
			sh scripts/scan_secrets.sh
		else
			python3 -I scripts/review_pass.py check "$local_sha" # cheap, so before the gate
			sh scripts/check.sh --full </dev/null
		fi
	elif ! $gated; then
		if [ -z "${SANDBOX_RUNTIME:-}" ]; then
			green "$local_sha" .claude/tmp/green-fast .claude/tmp/green-full || { echo "pre-push: no gate passed on this code; run sh scripts/check.sh in Claude Code's sandbox" >&2; exit 1; }
		else
			sh scripts/check.sh </dev/null
		fi
		sh scripts/scan_secrets.sh
		gated=true
	fi
done
