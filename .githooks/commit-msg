#!/bin/sh
# Refuse a subject that is not conventional (`type(scope)!: what`, 72 characters at most; git's
# own merge and revert subjects pass), and co-author or AI attribution lines. Comment lines and
# the diff that `git commit -v` appends below the scissors line are not part of the message.
msg=$(sed '/^# -* >8 -*$/,$d' "$1" | grep -v '^#')
subject=$(printf '%s\n' "$msg" | sed -n '1p')
case $subject in
"Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) ;;
*)
	if ! printf '%s\n' "$subject" | grep -qE '^(feat|fix|docs|test|refactor|perf|build|ci|chore|style|revert)(\([a-z0-9-]+\))?!?: [^ ]'; then
		echo "commit-msg: the subject is 'type(scope): what', type one of feat fix docs test refactor perf build ci chore style revert." >&2
		exit 1
	fi
	if [ "$(printf '%s' "$subject" | python3 -I -c 'import sys; print(len(sys.stdin.buffer.read().decode()))')" -gt 72 ]; then # characters, in any locale
		echo "commit-msg: the subject is over 72 characters." >&2
		exit 1
	fi
	;;
esac
if printf '%s\n' "$msg" | grep -qiE '^(co-authored|assisted)-by:|^🤖|^generated (with|by) \[?claude|noreply@anthropic\.com'; then
	echo "commit-msg: co-author / attribution lines are not allowed in this repo." >&2
	exit 1
fi
# The repository will be public, messages included: gitleaks scans files, so the message here,
# with both rule sets and no `gitleaks:allow` way out (F090, F113).
command -v gitleaks >/dev/null || { echo "commit-msg: gitleaks is not installed (docs/DEVELOPMENT.md)" >&2; exit 1; }
for config in gitleaks.toml gitleaks-private.toml; do
	if ! printf '%s\n' "$msg" | gitleaks stdin --no-banner --redact --log-level error --ignore-gitleaks-allow \
		--config "$(dirname "$0")/../scripts/$config" >&2; then
		echo "commit-msg: the message holds what scripts/$config refuses (above)." >&2
		exit 1
	fi
done
