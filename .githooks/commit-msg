#!/bin/sh
# Refuse a subject that is not conventional (`type(scope)!: what`, 72 characters at most; git's
# own merge and revert subjects pass), and co-author or AI attribution lines, a session's link
# included (F591). Comment lines and the diff that `git commit -v` appends below the scissors line
# are not part of the message.
msg=$(sed '/^# -* >8 -*$/,$d' "$1" | grep -v '^#')
subject=$(printf '%s\n' "$msg" | sed -n '1p')
case $subject in
"Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) ;;
*)
	if ! printf '%s\n' "$subject" | grep -qE '^(feat|fix|docs|test|refactor|perf|build|ci|chore|style|revert)(\([a-z0-9-]+\))?!?: [^ ]'; then
		echo "commit-msg: the subject is 'type(scope): what', type one of feat fix docs test refactor perf build ci chore style revert." >&2
		exit 1
	fi
	# characters, in any locale; a python3 that cannot count them refuses (F5080): `[ "" -gt 72 ]` is no answer
	length=$(printf '%s' "$subject" | python3 -I -c 'import sys; print(len(sys.stdin.buffer.read().decode()))') || {
		echo "commit-msg: python3 cannot count the subject's characters" >&2
		exit 1
	}
	if [ "$length" -gt 72 ]; then
		echo "commit-msg: the subject is over 72 characters." >&2
		exit 1
	fi
	;;
esac
if printf '%s\n' "$msg" | grep -qiE '^(co-authored|assisted)-by:|^claude-session:|^🤖|^generated (with|by) \[?claude|noreply@anthropic\.com'; then
	echo "commit-msg: co-author / attribution lines are not allowed in this repo." >&2
	exit 1
fi
# Only with GNOWORLD_STRICT=1 (the speed plan, 2026-11-06: by default no declaration check runs; scripts/test_hooks.sh runs it on).
# A fix of the product proves itself with a test that fails without it (prove_fix.py, in the full
# gate): one that changes product code with no test, and no line `No-test: <why>`, is refused here,
# at once, as prove_fix.py would refuse it later. What is staged is what the commit holds.
if [ "${GNOWORLD_STRICT:-}" = 1 ] && printf '%s\n' "$subject" | grep -qE '^fix(\(.+\))?!?:'; then
	staged=$(git diff --cached --name-only --diff-filter=AMDT) || { echo "commit-msg: git cannot list what is staged" >&2; exit 1; }
	tests='(\.test\.tsx?|\.spec\.ts|_test\.gno|_filetest\.gno|_test\.go)$'
	product=$(printf '%s\n' "$staged" | grep -E '^(packages|gno|app|admin|server)/') || :
	kept=$(git diff --cached --name-only --diff-filter=AM | grep -E '^(packages|gno|app|admin|server)/' | grep -E "$tests") || :
	if printf '%s\n' "$product" | grep -qvE "$tests|^$" && [ -z "$kept" ] && ! printf '%s\n' "$msg" | grep -qE '^No-test: [^ ]'; then
		echo "commit-msg: a fix of the product comes with the test that shows its bug, or a line 'No-test: <why>' (prove_fix.py)." >&2
		exit 1
	fi
fi
# The repository will be public, messages included: gitleaks scans files, so the message here,
# with both rule sets and no `gitleaks:allow` way out (F090, F113).
command -v gitleaks >/dev/null || { echo "commit-msg: gitleaks is not installed (docs/DEVELOPMENT.md)" >&2; exit 1; }
for config in gitleaks.toml gitleaks-private.toml; do
	if ! printf '%s\n' "$msg" | gitleaks stdin --no-banner --redact --log-level error --ignore-gitleaks-allow \
		--config "$(dirname "$0")/$config" >&2; then
		echo "commit-msg: the message holds what $config refuses (above)." >&2
		exit 1
	fi
done
# A hidden character in a message shows nothing or changes how it reads, and scripts parse messages (a `Removed-test:` line
# shown as one name and read as another, F5079). In Claude Code's sandbox, whose tools once wrote one raw, the staged
# scripts/hidden.py reads each message as it is written, a merge's and an amend's included (F5085), as pre-commit runs the
# staged scripts there; outside, nothing of the repository runs (F076), and check_docs reads the branch's messages at the
# next gate. With no staged rule, or a python3 that fails, nothing proves the message clean.
if [ -n "${SANDBOX_RUNTIME:-}" ]; then
	rule=$(git show :scripts/hidden.py 2>/dev/null) && [ -n "$rule" ] || {
		echo "commit-msg: git cannot read the staged scripts/hidden.py, so the message is not proven free of hidden characters" >&2
		exit 1
	}
	if ! printf '%s\n' "$msg" | python3 -I -c "$rule"; then
		echo "commit-msg: the message holds a hidden character (above), which a message writes as an escape, or scripts/hidden.py could not read it" >&2
		exit 1
	fi
fi
