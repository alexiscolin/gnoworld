{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreFiles": ["docs/**", ".claude/workflows/**"],
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": { "entry": ["scripts/lighthouse_check.mjs"], "ignoreBinaries": ["lighthouse"] },
    "app": {
      "entry": ["src/**/*.test.{ts,tsx}"],
      "react-router": { "config": ["react-router.config.ts"] },
      "playwright": { "config": ["playwright.config.ts", "playwright.stories.config.ts"] }
    },
    "packages/ui": { "ignoreDependencies": ["@fontsource-variable/geist", "@fontsource-variable/geist-mono"] },
    "server": { "ignoreDependencies": ["@hono/zod-validator"] }
  }
}
