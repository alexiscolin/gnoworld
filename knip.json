{
  "$schema": "./node_modules/knip/schema.json",
  "ignoreFiles": ["docs/**", ".claude/workflows/**"],
  "treatConfigHintsAsErrors": true,
  "workspaces": {
    ".": { "entry": ["!evals/**"], "project": ["**/*.{js,mjs,cjs,ts,tsx}", "!evals/**"] },
    "app": {
      "entry": ["src/**/*.test.{ts,tsx}", "lab/main.ts", "tests/e2e/workshopBackend.mjs", "recording/serve.mjs"],
      "react-router": { "config": ["react-router.config.ts"] },
      "playwright": {
        "config": ["playwright.config.ts", "playwright.stories.config.ts", "playwright.pictures.config.ts"]
      }
    },
    "packages/ui": { "ignoreDependencies": ["@fontsource-variable/geist", "@fontsource-variable/geist-mono"] },
    "server": { "ignoreDependencies": ["@hono/zod-validator"] }
  }
}
