{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "mutate": [
    "{server/src/login,app/src/features/login,app/src/lib/ergo,server/src/roles,app/src/lib/adena,packages/core/src/chain,packages/core/src/markdown,app/src/sw,server/src/ergo,jarvis/src}/**/*.{ts,tsx}",
    "{app/src/lib/api/login.ts,app/src/csp.ts,app/src/cspOrigins.ts,app/src/cspForms.ts,app/src/lib/chain/evalCall.ts,server/src/guard.ts,server/src/limit.ts,server/src/config.ts,app/src/features/chat/embeds.ts,app/src/features/chat/Embed.tsx,app/src/features/realms/useExternalLinks.tsx,app/src/leaving.tsx,app/src/pagePath.ts}",
    "{packages/service/src/net.ts,packages/service/src/settings.ts}",
    "!**/*.test.{ts,tsx}",
    "!**/testing/**",
    "!jarvis/src/main.ts",
    "!jarvis/src/**/*.bench.ts"
  ],
  "incremental": true,
  "dryRunTimeoutMinutes": 20,
  "ignoreStatic": true,
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "clearTextReporter": {
    "allowColor": false
  },
  "thresholds": {
    "high": 95,
    "low": 85
  },
  "ignorePatterns": [
    "docs/**",
    "!docs/OPERATIONS.md",
    "/gno",
    ".claude",
    "coverage",
    "CLAUDE.md",
    "CLAUDE.local.md",
    "AGENTS.md"
  ],
  "mutator": {
    "excludedMutations": ["StringLiteral", "ObjectLiteral", "ArrayDeclaration"]
  }
}
