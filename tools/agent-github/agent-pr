#!/usr/bin/env -S -i LC_ALL=C /opt/homebrew/bin/python3 -I
"""agent-pr: publish with the token this machine holds for a repository (gnoworld's D13159-D13163: the owner's own, or the agent
account's): push one agent/** branch from a git bundle, or open a pull request, to a repository its allow list names. It runs outside the sandbox (a Claude Code
excluded command), so it trusts nothing of its caller's: the shebang empties the environment; it never runs git in the
caller's repository (the bundle carries the commits); it reads no file but under the caller's temporary space, following no
link; the token reaches git and gh in their environment alone, git only for github.com.

Usage: agent-pr push <owner/repo> <bundle>
       agent-pr open <owner/repo> <agent/branch> <pr file: the title, a blank line, the body>
"""
import os
import pwd
import re
import shutil
import stat
import subprocess
import sys
import tempfile

GITHUB = "https://github.com"
TOOLS = "/opt/homebrew/bin:/usr/bin:/bin"
STATE = os.path.join(pwd.getpwuid(os.getuid()).pw_dir, ".local/share/agent-github")
# One drop folder in the caller's temporary space, where no worktree lives (the sandbox hides some files of those).
SPACE = f"/private/tmp/claude-{os.getuid()}/agent-pr/"

OWNER = re.compile(r"[A-Za-z0-9][A-Za-z0-9-]{0,38}")
NAME = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]{0,99}")
PART = re.compile(r"[A-Za-z0-9_][A-Za-z0-9._-]{0,99}")
TOKEN = re.compile(r"ghp_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{22,255}")
# An allow-list line: a repository, then the name of the token it uses when not the default one (token.<name>).
LINE = re.compile(r"(\S+)(?: ([a-z0-9][a-z0-9-]{0,31}))?")
SHA = re.compile(r"[0-9a-f]{40}|[0-9a-f]{64}")
# The keys git writes into a bare repository it creates; any other key in a clean copy's config is refused.
CLEAN_KEYS = {"core.repositoryformatversion", "core.filemode", "core.bare", "core.ignorecase", "core.precomposeunicode",
              "core.logallrefupdates", "extensions.objectformat", "init.defaultbranch"}
# What runs on GitHub when pushed: a person's to push, never the agent's (a workflow on a branch runs with the repository's rights).
RUNS = ("/.github/workflows/", "/.github/actions/")
BUNDLE_MAX = 512 << 20
PR_MAX = 64 << 10
# git asks its helper for every host; only github.com gets the token.
CREDENTIAL = ('!f() { test "$1" = get || exit 0; ok=; while read -r l; do [ "$l" = host=github.com ] && ok=1; done; '
              'test -n "$ok" && echo username=x-access-token && echo "password=$AGENT_TOKEN"; }; f')


class Refused(Exception):
    """What the caller asked for is not allowed (exit 2)."""


class Failed(Exception):
    """What it needs is missing or failed (exit 1)."""


def repository(arg):
    owner, _, name = arg.partition("/")
    if not (OWNER.fullmatch(owner) and NAME.fullmatch(name)) or name.endswith(".git") or ".." in name:
        raise Refused(f"not a repository written owner/name: {arg!r}")
    try:
        fd = os.open(os.path.join(STATE, "repos.allow"), os.O_RDONLY | os.O_NOFOLLOW)
    except OSError:
        raise Refused(f"no allow list at {STATE}/repos.allow: no repository is allowed") from None
    with os.fdopen(fd) as f:
        lines = [line.strip() for line in f if line.strip() and not line.startswith("#")]
    tokens = {}
    for line in lines:
        m = LINE.fullmatch(line)
        if m:
            tokens.setdefault(m.group(1), "token" if m.group(2) is None else f"token.{m.group(2)}")
    if arg not in tokens:
        raise Refused(f"{arg} is not on {STATE}/repos.allow")
    return owner, name, tokens[arg]


def branch_ok(branch):
    parts = branch.split("/")
    return (2 <= len(parts) <= 9 and parts[0] == "agent" and ".." not in branch and all(PART.fullmatch(p) for p in parts[1:]))


def take(path, limit, dest):
    """Copies a file of the caller's space to dest, walking each folder of its path without following a link."""
    if path.startswith("/tmp/"):
        path = "/private" + path  # macOS's /tmp is a link to /private/tmp; nothing else is resolved
    parts = path.split("/")
    if not path.startswith(SPACE) or "" in parts[1:] or "." in parts or ".." in parts:
        raise Refused(f"a file outside {SPACE}, or not written plainly: {path!r}")
    flags = os.O_RDONLY | os.O_NOFOLLOW | getattr(os, "O_CLOEXEC", 0)
    fd = os.open("/", os.O_RDONLY | os.O_DIRECTORY)
    try:
        for part in parts[1:-1]:
            try:
                nxt = os.open(part, flags | os.O_DIRECTORY, dir_fd=fd)
            except OSError as e:
                raise Refused(f"{path}: a folder of its path is missing or a link ({e.strerror})") from None
            os.close(fd)
            fd = nxt
        try:
            f = os.open(parts[-1], flags, dir_fd=fd)
        except OSError as e:
            raise Refused(f"{path}: missing or a link ({e.strerror})") from None
    finally:
        os.close(fd)
    with os.fdopen(f, "rb") as src:
        st = os.fstat(src.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or st.st_size > limit:
            raise Refused(f"{path}: not a regular file of one name and {limit} bytes at most (a hard link is refused)")
        data = src.read(limit + 1)
    if len(data) > limit:
        raise Refused(f"{path}: over {limit} bytes")
    with open(dest, "wb") as out:
        out.write(data)
    return data


def read_token(which):
    path = os.path.join(STATE, which)
    try:
        fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    except OSError as e:
        raise Failed(f"no token at {path} ({e.strerror})") from None
    with os.fdopen(fd, "rb") as f:
        st = os.fstat(f.fileno())
        if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid() or st.st_mode & 0o077:
            raise Failed(f"{path} is not a file of yours that only you can read (chmod 600)")
        data = f.read(4096)
    text = data[:-1] if data.endswith(b"\n") else data
    try:
        token = text.decode("ascii")
    except UnicodeDecodeError:
        token = ""
    if not TOKEN.fullmatch(token):
        raise Failed(f"{path} does not hold exactly one GitHub token line")
    return token


def env(work, **more):
    base = {"PATH": TOOLS, "HOME": work, "LC_ALL": "C", "TMPDIR": work, "GIT_CONFIG_NOSYSTEM": "1",
            "GIT_CONFIG_GLOBAL": os.devnull, "GIT_TERMINAL_PROMPT": "0"}
    return {**base, **more}


def run(argv, environ, what, ok=(0,), given=None):
    try:
        p = subprocess.run(argv, env=environ, cwd=environ["HOME"], capture_output=True, text=True,
                           **({"input": given} if given is not None else {"stdin": subprocess.DEVNULL}))
    except FileNotFoundError:
        raise Failed(f"{argv[0]} is missing from {TOOLS}") from None
    if p.returncode not in ok:
        raise Failed(f"{what} failed ({p.returncode}): {(p.stderr or p.stdout).strip()[-600:]}")
    return p


def git(work, token, *args, ok=(0,), given=None):
    argv = ["git", "-c", "core.hooksPath=/dev/null", "-c", "credential.helper=", "-c", f"credential.helper={CREDENTIAL}", *args]
    return run(argv, env(work, AGENT_TOKEN=token), "git " + " ".join(a for a in args if not a.startswith("/"))[:80], ok, given)


def clean_copy(work, token, owner, name):
    """The helper's own bare copy of the repository, created by it, whose config holds only what git wrote."""
    cache = os.path.join(STATE, "repos", owner, f"{name}.git")
    if not os.path.isdir(cache):
        os.makedirs(os.path.dirname(cache), mode=0o700, exist_ok=True)
        git(work, token, "init", "-q", "--bare", cache)
    keys = git(work, token, "config", "--file", os.path.join(cache, "config"), "--name-only", "--list").stdout.split()
    if set(keys) - CLEAN_KEYS or os.path.exists(os.path.join(cache, "objects", "info", "alternates")):
        raise Failed(f"{cache} holds config or alternates it did not write: remove the folder, it is made again")
    return cache


def gitleaks_config(work):
    config = os.path.join(work, "gitleaks.toml")
    if not os.path.exists(config):
        with open(config, "w") as f:
            f.write("[extend]\nuseDefault = true\n")
    return config


def scan(work, cache, base, tip, token):
    """gitleaks over every commit from base to tip, merges included, by gitleaks's own rules alone; the commits it read
    must be the commits pushed."""
    count = int(git(work, token, "-C", cache, "rev-list", "--count", f"{base}..{tip}").stdout.strip())
    if count == 0:
        return
    empty = os.path.join(work, "noignore")
    os.makedirs(empty, exist_ok=True)
    argv = ["gitleaks", "git", "--no-banner", "--redact", "--ignore-gitleaks-allow", "--config", gitleaks_config(work),
            "--gitleaks-ignore-path", empty, "--log-level", "info",
            f"--log-opts=--text --no-ext-diff --no-textconv -m {base}..{tip}", cache]
    p = run(argv, env(work), "gitleaks", ok=(0, 1))
    if p.returncode == 1:
        raise Refused(f"gitleaks found a secret in the commits to push; nothing pushed:\n{p.stdout.strip()[-1500:]}")
    said = re.search(r"\b(\d+) commits scanned", re.sub(r"\x1b\[[0-9;]*m", "", p.stdout + p.stderr))
    if not said or int(said.group(1)) != count:
        raise Failed(f"gitleaks did not report reading the {count} commits to push; nothing pushed")


def scan_text(work, text, what):
    folder = tempfile.mkdtemp(dir=work)
    with open(os.path.join(folder, "text.txt"), "w") as f:
        f.write(text)
    p = run(["gitleaks", "dir", "--no-banner", "--redact", "--ignore-gitleaks-allow", "--config", gitleaks_config(work), folder],
            env(work), "gitleaks", ok=(0, 1))
    if p.returncode == 1:
        raise Refused(f"gitleaks found a secret in {what}; nothing done")


def push(repo_arg, bundle_arg, work):
    owner, name, which = repository(repo_arg)
    bundle = os.path.join(work, "push.bundle")
    data = take(bundle_arg, BUNDLE_MAX, bundle)
    if not data.startswith(b"# v2 git bundle\n"):
        raise Refused("not a v2 git bundle (git bundle create <file> agent/<name>)")
    token = read_token(which)
    url = f"{GITHUB}/{owner}/{name}.git"
    heads = git(work, token, "ls-remote", "--symref", url, "HEAD").stdout
    m = re.search(r"^ref: refs/heads/(\S+)\tHEAD$", heads, re.M)
    if not m or not re.fullmatch(r"[A-Za-z0-9._/-]{1,200}", m.group(1)):
        raise Failed(f"{owner}/{name} names no default branch")
    default = m.group(1)
    cache = clean_copy(work, token, owner, name)
    # Each run fetches into a ref of its own and pushes the commit it resolved and scanned, by its id: what is scanned is pushed.
    git(work, token, "-C", cache, "-c", "fetch.fsckObjects=true", "fetch", "-q", "--no-tags", url,
        f"+refs/heads/{default}:refs/remotes/origin/{default}")
    listed = git(work, token, "-C", cache, "bundle", "list-heads", bundle).stdout.splitlines()
    refs = [line.split(" ", 1) for line in listed]
    if len(refs) != 1 or len(refs[0]) != 2 or not SHA.fullmatch(refs[0][0]):
        raise Refused("the bundle must hold one branch, agent/<name>, and nothing else")
    # A tag or any other ref keeps its refs/ prefix, which no agent/<name> branch passes; git checks the rest of the name.
    branch = refs[0][1].removeprefix("refs/heads/")
    if not branch_ok(branch):
        raise Refused(f"only one agent/<name> branch is pushed, a plain name: {branch!r}")
    git(work, token, "check-ref-format", f"refs/heads/{branch}")
    git(work, token, "-C", cache, "bundle", "verify", "-q", bundle)
    scratch = f"refs/agent-pr/{os.path.basename(work)}/{branch}"
    try:
        git(work, token, "-C", cache, "-c", "fetch.fsckObjects=true", "fetch", "-q", "--no-tags", bundle,
            f"+refs/heads/{branch}:{scratch}")
        tip = git(work, token, "-C", cache, "rev-parse", "--verify", f"{scratch}^{{commit}}").stdout.strip()
        base = git(work, token, "-C", cache, "rev-parse", "--verify", f"refs/remotes/origin/{default}^{{commit}}").stdout.strip()
        names = git(work, token, "-C", cache, "log", "-m", "--format=", "--name-only", f"{base}..{tip}").stdout.splitlines()
        # A link at .github/workflows itself is its bare name: the folder's own name counts too.
        runs = sorted({n for n in names if any(("/" + n + "/").startswith(r) for r in RUNS)})
        if runs:
            raise Refused(f"what runs on GitHub is a person's to push, not the agent's: {', '.join(runs)}")
        scan(work, cache, base, tip, token)
        # Every commit whole, as git holds it (its headers, a signature or one of its own included), and every name it touches.
        commits = git(work, token, "-C", cache, "rev-list", f"{base}..{tip}").stdout
        whole = git(work, token, "-C", cache, "cat-file", "--batch", given=commits).stdout
        meta = whole + "\n".join(names)
        scan_text(work, f"{branch}\n{meta}", "the commits' messages, authors or file names, or the branch's name")
        git(work, token, "-C", cache, "push", "-q", url, f"{tip}:refs/heads/{branch}")
    finally:
        git(work, token, "-C", cache, "update-ref", "-d", scratch, ok=(0, 1, 128))
    print(f"agent-pr: pushed {branch} to {owner}/{name} ({tip[:12]})")


def open_pr(repo_arg, branch, pr_arg, work):
    owner, name, which = repository(repo_arg)
    if not branch_ok(branch):
        raise Refused(f"a pull request comes from one agent/<name> branch: {branch!r}")
    data = take(pr_arg, PR_MAX, os.path.join(work, "pr.md"))
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        raise Refused("the pull request's file is not UTF-8 text") from None
    title, _, body = text.partition("\n")
    if not title or len(title) > 256 or re.search(r"[\x00-\x1f\x7f]", title):
        raise Refused("the file's first line, the title, is 1 to 256 characters")
    body = body.removeprefix("\n")
    token = read_token(which)
    scan_text(work, f"{branch}\n{title}\n{body}", "the title or the body")
    body_file = os.path.join(work, "body.md")
    with open(body_file, "w") as f:
        f.write(body)
    environ = env(work, GH_TOKEN=token, GH_CONFIG_DIR=os.path.join(work, "gh"), GH_PROMPT_DISABLED="1",
                  GH_NO_UPDATE_NOTIFIER="1", NO_COLOR="1")
    p = run(["gh", "pr", "create", f"--repo={owner}/{name}", f"--head={branch}", f"--title={title}", f"--body-file={body_file}"],
            environ, "gh pr create")
    print(p.stdout.strip())


def main(argv):
    usage = "usage: agent-pr push <owner/repo> <bundle> | agent-pr open <owner/repo> <agent/branch> <pr file>"
    if len(argv) == 3 and argv[0] == "push":
        job = lambda work: push(argv[1], argv[2], work)
    elif len(argv) == 4 and argv[0] == "open":
        job = lambda work: open_pr(argv[1], argv[2], argv[3], work)
    else:
        print(usage, file=sys.stderr)
        return 2
    tmp = os.path.join(STATE, "tmp")
    os.makedirs(tmp, mode=0o700, exist_ok=True)
    work = tempfile.mkdtemp(dir=tmp)
    try:
        job(work)
        return 0
    except Refused as e:
        print(f"agent-pr: refused: {e}", file=sys.stderr)
        return 2
    except Failed as e:
        print(f"agent-pr: {e}", file=sys.stderr)
        return 1
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
